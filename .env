# API Keys
API_KEY=your-google-ai-api-key-here
MAPBOX_TOKEN=your-mapbox-access-token-here

# Para obtener un token de Mapbox:
# 1. Visita https://www.mapbox.com/
# 2. Crea una cuenta gratuita
# 3. Ve a tu Account > Access tokens
# 4. Copia tu Default Public Token o crea uno nuevo
# 5. Reemplaza "your-mapbox-access-token-here" con tu token real